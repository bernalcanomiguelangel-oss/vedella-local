// Vedella Local — multi-farm traceable Catalan beef marketplace.
// Data model per design.md section 3. Integrity enforced here (FKs, uniqueness,
// non-null farmId) plus a shared src/lib/validateLot.ts guard and (where supported)
// SQLite CHECK constraints via migration SQL for units>=0 and date ordering.
//
// NOTE: prices are stored as integer cents. Catalan is the default language.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enumerations.
//
// SQLite has no native enum support in Prisma, so enum-like fields are stored as
// plain strings. The allowed values are documented here and enforced by Zod at
// the application boundary.
//
//   Role:        platform_admin | farm_manager | customer
//   ProductKind: pack | cut
//   Lifecycle:   draft | pending_review | approved | active | inactive | rejected | archived
//   TranslationStatus: machine | in_review | approved
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Core entities
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("customer") // Role enum, see header
  // Salted bcrypt hash (nullable so pre-auth/legacy identities still resolve).
  // Plaintext passwords are NEVER stored.
  passwordHash String?
  // When true the user must change their password before reaching any protected
  // page (e.g. the seeded main admin starts with a temporary password).
  mustChangePassword Boolean @default(false)
  // Last successful login timestamp (set by the login action).
  lastLoginAt DateTime?
  // A farm_manager is linked to the farm they manage (one farm -> one manager).
  farm      Farm?    @relation("FarmManager", fields: [farmId], references: [id])
  farmId    String?  @unique
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Farm {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  town        String
  comarca     String
  breed       String
  foundedYear Int
  animalCount Int
  story       String
  lifecycle   String    @default("draft") // Lifecycle enum, see header
  isApproved  Boolean   @default(false)
  isActive    Boolean   @default(false)
  isTest      Boolean   @default(false)

  // --- Structured rich farm-profile fields (decision 3 / FEAT-004). ---------
  // These restore the Lovable farm page's storytelling/traceability sections as
  // editable, structured data. All are nullable and additive: historical farms
  // keep working. Edits by a farm_manager are SUBMITTED to review (a
  // FarmProfileEdit row), never applied live; only platform_admin edits the
  // "other information" directly.
  productionMethod   String? // e.g. extensiu, cicle tancat
  traceabilityInfo   String? // how the farm traces granja -> lot -> tall -> paquet
  welfareInfo        String? // animal welfare notes
  feedInfo           String? // feeding / pasture notes
  locationDetail     String? // detailed location / address text
  latitude           Float?
  longitude          Float?
  heroImageRef       String? // stored image reference (not a secret)
  galleryRefs        String? // JSON array of image references
  contactEmail       String?
  contactPhone       String?
  websiteUrl         String?
  // "Other information" is platform-admin-only free text (never editable by a
  // farm_manager, even through review).
  otherInformation   String?

  manager   User?  @relation("FarmManager")

  products Product[]
  offers   FarmProductOffer[]
  lots     Lot[]
  certifications FarmCertification[]
  profileEdits   FarmProfileEdit[]
  packs          Pack[]
  packItemsV2    PackItemV2[]
  packAcceptances PackFarmAcceptance[]
  cycleParticipations CycleFarm[]
  cycleOfferAvailability CycleOfferAvailability[]
  fulfilmentGroups FulfilmentGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Rich farm profile: certifications + review-gated profile edits (FEAT-004,
// decision 3 + rules B/C).
//
// A FarmCertification is an UNVERIFIED claim until a platform_admin approves it.
// Unverified claims must NEVER be exposed to any public read path. The
// submitter attaches an evidence reference (a stored file ref, never inline
// secrets). Only status=approved rows are public.
// ---------------------------------------------------------------------------
model FarmCertification {
  id              String  @id @default(cuid())
  farm            Farm    @relation(fields: [farmId], references: [id])
  farmId          String
  type            String // e.g. "IGP", "organic", "welfare", "breed"
  title           String
  body            String  @default("")
  evidenceRef     String? // reference to an uploaded evidence file (not public until approved)
  // draft | pending_review | approved | rejected
  status          String  @default("draft")
  submittedByUserId String?
  approvedByUserId  String?
  approvedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([status])
}

// A profile edit submitted by a farm_manager, awaiting platform_admin approval.
// The proposed changes are stored as a JSON patch in `changes`; they are only
// applied to the Farm row when a platform_admin approves the edit.
model FarmProfileEdit {
  id              String  @id @default(cuid())
  farm            Farm    @relation(fields: [farmId], references: [id])
  farmId          String
  // JSON object of { field: newValue } proposed by the farm_manager.
  changes         String
  // pending_review | approved | rejected
  status          String  @default("pending_review")
  submittedByUserId String?
  approvedByUserId  String?
  approvedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([status])
}

model Product {
  id            String      @id @default(cuid())
  farm          Farm        @relation(fields: [farmId], references: [id])
  farmId        String // required: every product belongs to a farm (R8)
  kind          String // ProductKind enum: pack | cut (see header)
  name          String
  description   String      @default("")
  basePriceCents Int

  // Cut facts (nullable; mainly used for kind = cut)
  weight     String?
  thickness  String?
  maturation String?
  packaging  String?
  shelfLife  String?

  lifecycle  String    @default("draft") // Lifecycle enum, see header
  isApproved Boolean   @default(false)
  isActive   Boolean   @default(false)
  isTest     Boolean   @default(false)

  // Pack -> cut links (a pack has many PackItems pointing at cut products)
  packItems    PackItem[] @relation("PackToItems")
  includedIn   PackItem[] @relation("CutInPacks")

  lots Lot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  // Composite candidate key so a Lot can reference (productId, farmId) together,
  // giving DB-level enforcement of R9 (lot.farmId must equal product.farmId).
  @@unique([id, farmId])
}

// ---------------------------------------------------------------------------
// Two-level product model (FEAT-003, migration M1-M4).
//
// ProductDefinition is the platform-curated, reusable canonical cut ("Entrecot").
// It is NOT directly sellable. FarmProductOffer is the farm-specific, sellable
// listing of a definition, carrying that farm's own price/weight/etc. This
// separates the reusable definition from the per-farm offer that the legacy
// Product table conflated. Both are additive this phase; the public catalog
// keeps rendering from the legacy Product path until a later feature.
// ---------------------------------------------------------------------------

model ProductDefinition {
  id             String  @id @default(cuid())
  canonicalName  String // e.g. "Entrecot"
  category       String // cut category / family; "needs-review" when unknown
  description    String  @default("")
  defaultPrep    String  @default("")
  translationKey String  @unique // for ca/es/en copy
  lifecycle      String  @default("draft") // Lifecycle enum; human-managed, AI never approves
  isApproved     Boolean @default(false)
  isActive       Boolean @default(false)
  isTest         Boolean @default(false)

  offers FarmProductOffer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([canonicalName])
}

model FarmProductOffer {
  id                  String            @id @default(cuid())
  farm                Farm              @relation(fields: [farmId], references: [id])
  farmId              String
  productDefinition   ProductDefinition @relation(fields: [productDefinitionId], references: [id])
  productDefinitionId String
  publicName          String
  internalSku         String?
  description         String            @default("")
  priceAmountCents    Int // integer cents (existing convention)
  priceUnit           String // per_unit | per_kg | per_pack ...
  currency            String            @default("EUR")

  // Structured facts parsed best-effort from the legacy free-text columns.
  expectedUnitWeightMinG Int?
  expectedUnitWeightMaxG Int?
  weightTolerancePercent Int?
  unitsPerPack           Int?
  thicknessMm            Int?
  maturationDays         Int?
  packagingMethod        String?
  storageState           String? // chilled | frozen ...
  minimumShelfLifeDays   Int?
  pickupAvailable        Boolean @default(false)

  // Original free-text preserved so a failed parse never loses data.
  legacyFacts String?

  lifecycle  String    @default("draft") // Lifecycle enum, see header
  isApproved Boolean   @default(false)
  isActive   Boolean   @default(false)
  archivedAt DateTime?
  isTest     Boolean   @default(false)

  lots Lot[]
  packItems PackItemV2[]
  orderItems OrderItem[]
  cycleOfferAvailability CycleOfferAvailability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Candidate key for the Lot composite FK (mirrors Product(id, farmId) today),
  // enforcing lot.farmId == offer.farmId at the DB level.
  @@unique([id, farmId])
  @@index([farmId])
  @@index([productDefinitionId])
}

model PackItem {
  id           String  @id @default(cuid())
  pack         Product @relation("PackToItems", fields: [packProductId], references: [id])
  packProductId String
  cut          Product @relation("CutInPacks", fields: [cutProductId], references: [id])
  cutProductId String
  quantity     Int     @default(1)

  @@unique([packProductId, cutProductId])
  @@index([packProductId])
}

// ---------------------------------------------------------------------------
// Pack model V2 (FEAT-004): curated bundle built from FarmProductOffers, which
// may span MULTIPLE farms. A multi-farm pack (isMultiFarm) can only go live
// after EVERY participating farm has accepted (PackFarmAcceptance.accepted).
// A single-farm pack may publish without the dual-accept step. The publish
// gate also requires all referenced offers to be approved+active.
// ---------------------------------------------------------------------------
model Pack {
  id          String  @id @default(cuid())
  // Owning farm for single-farm packs; null for a multi-farm pack created by
  // the platform. isMultiFarm is the authoritative flag.
  farm        Farm?   @relation(fields: [farmId], references: [id])
  farmId      String?
  isMultiFarm Boolean @default(false)
  publicName  String
  description String  @default("")
  priceAmountCents Int @default(0)

  lifecycle  String  @default("draft") // Lifecycle enum, see header
  isApproved Boolean @default(false)
  isActive   Boolean @default(false)
  isTest     Boolean @default(false)

  items       PackItemV2[]
  acceptances PackFarmAcceptance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
}

// A composition line of a Pack. Preserves item-level farm + lot traceability so
// a multi-farm pack records which farm/offer/lot each included item came from.
model PackItemV2 {
  id                 String           @id @default(cuid())
  pack               Pack             @relation(fields: [packId], references: [id], onDelete: Cascade)
  packId             String
  offer              FarmProductOffer @relation(fields: [farmProductOfferId], references: [id])
  farmProductOfferId String
  farm               Farm             @relation(fields: [farmId], references: [id])
  farmId             String
  lot                Lot?             @relation(fields: [lotId], references: [id])
  lotId              String?
  quantity           Int              @default(1)

  @@index([packId])
  @@index([farmProductOfferId])
  @@index([farmId])
}

// Per-farm acceptance of participation in a (multi-farm) pack. A multi-farm
// pack requires accepted=true for EVERY participating farm before going live.
// Only that farm's manager (or platform_admin acting WITHOUT forcing) sets its
// own acceptance; a platform_admin can NEVER force another farm's acceptance.
model PackFarmAcceptance {
  id               String   @id @default(cuid())
  pack             Pack     @relation(fields: [packId], references: [id], onDelete: Cascade)
  packId           String
  farm             Farm     @relation(fields: [farmId], references: [id])
  farmId           String
  accepted         Boolean  @default(false)
  acceptedByUserId String?
  acceptedAt       DateTime?
  declinedReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([packId, farmId])
  @@index([packId])
  @@index([farmId])
}

model Lot {
  id         String   @id @default(cuid())
  farm       Farm     @relation(fields: [farmId], references: [id])
  farmId     String
  // LEGACY composite FK into Product(id, farmId). Kept nullable for one release
  // (M4) so historical data and the old read path survive while the new offer
  // path is backfilled. Do NOT drop yet.
  product    Product? @relation(fields: [productId, farmId], references: [id, farmId])
  productId  String?
  // NEW composite FK into FarmProductOffer(id, farmId): the DB-level backstop
  // for R9 under the two-level model (lot.farmId must equal its offer's farmId).
  // Nullable this phase; flipped non-null for cut-backed lots in a later feature.
  offer             FarmProductOffer? @relation(fields: [farmProductOfferId, farmId], references: [id, farmId])
  farmProductOfferId String?
  reference  String   @unique // R11 unique lot reference
  units      Int      @default(0) // R12 non-negative (enforced by CHECK + guard)
  isWithdrawn Boolean @default(false) // R13
  isTest     Boolean  @default(false) // R15

  // R10 date ordering: slaughter <= cutting <= packing < expiry
  slaughterDate DateTime
  cuttingDate   DateTime
  packingDate   DateTime
  expiryDate    DateTime

  packItems     PackItemV2[]
  cycleOfferAvailability CycleOfferAvailability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([productId])
  @@index([farmProductOfferId])
}

model ReservationCycle {
  id           String   @id @default(cuid())
  name         String
  zone         String
  closeDate    DateTime
  deliveryDate DateTime
  totalPlaces  Int
  freePlaces   Int
  transportNote String  @default("")
  isActive     Boolean  @default(false)
  isTest       Boolean  @default(false)

  // --- Enrichment (FEAT-004 / M6). All nullable, additive. The legacy
  // closeDate/deliveryDate/totalPlaces/freePlaces columns are preserved. ------
  internalName     String?
  publicTitle      String?
  // draft | open | closed | fulfilling | fulfilled | cancelled | archived
  status           String?  @default("open")
  openAt           DateTime?
  closeAt          DateTime? // precise reservation-close timestamp (blocks after)
  pickupDate       DateTime?
  deliveryPriceCents Int?

  orders Order[]
  farms  CycleFarm[]
  offerAvailability CycleOfferAvailability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Participating farms in a cycle, with per-farm capacity allocation.
model CycleFarm {
  id               String           @id @default(cuid())
  cycle            ReservationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  cycleId          String
  farm             Farm             @relation(fields: [farmId], references: [id])
  farmId           String
  allocatedPlaces  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cycleId, farmId])
  @@index([cycleId])
  @@index([farmId])
}

// Which offers are usable (have an eligible lot) within a cycle. Populated by
// the seed/backfill (M6) from offers that have a non-withdrawn, in-stock lot.
model CycleOfferAvailability {
  id                 String           @id @default(cuid())
  cycle              ReservationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  cycleId            String
  offer              FarmProductOffer @relation(fields: [farmProductOfferId], references: [id])
  farmProductOfferId String
  farm               Farm             @relation(fields: [farmId], references: [id])
  farmId             String
  // The eligible lot backing this offer in the cycle (null when none found).
  lot                Lot?             @relation(fields: [lotId], references: [id])
  lotId              String?
  // True when an eligible lot was found; false flags an offer without stock.
  hasEligibleLot     Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cycleId, farmProductOfferId])
  @@index([cycleId])
  @@index([farmId])
}

model Order {
  id                    String   @id @default(cuid())
  cycle                 ReservationCycle @relation(fields: [cycleId], references: [id])
  cycleId               String
  customer              User?    @relation(fields: [customerId], references: [id])
  customerId            String?
  // Snapshot of a representative lot reference printed on the order (R7).
  lotReferenceSnapshot  String   @default("")
  // Historical orders keep the existing default; the expanded enum documents
  // the fuller set: reserved | confirmed | fulfilling | fulfilled | cancelled.
  status                String   @default("reserved")
  subtotalCents         Int      @default(0)
  discountCents         Int      @default(0)
  deliveryFeeCents      Int      @default(600)
  totalCents            Int      @default(0)
  isTest                Boolean  @default(false)

  // --- Enrichment (FEAT-004 / M5). All nullable, additive. Historical orders
  // keep null here and remain valid; totals are untouched. --------------------
  attributionChannel   String?
  attributionCampaign  String?
  promisedDeliveryDate DateTime?
  deliveryMethod       String? // delivery | pickup
  isPickup             Boolean?  @default(false)
  pickupLocation       String?

  items OrderItem[]
  fulfilmentGroups FulfilmentGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cycleId])
}

// Farm-level slice of a (possibly multi-farm) order. Each participating farm
// sees ONLY its own FulfilmentGroup, so a multi-farm order is split by farm.
model FulfilmentGroup {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  farm      Farm     @relation(fields: [farmId], references: [id])
  farmId    String
  // pending | preparing | ready | delivered | cancelled
  status    String   @default("pending")
  subtotalCents Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, farmId])
  @@index([orderId])
  @@index([farmId])
}

model OrderItem {
  id           String @id @default(cuid())
  order        Order  @relation(fields: [orderId], references: [id])
  orderId      String
  // Snapshotted fields so historical orders remain intact (R14).
  productId    String?
  nameSnapshot String
  priceCentsSnapshot Int
  lotReferenceSnapshot String @default("")
  quantity     Int    @default(1)

  // --- Enrichment (FEAT-004 / M5). All nullable, additive. Historical items
  // keep their text snapshots with null FKs (R14); open orders get backfilled. -
  offer              FarmProductOffer? @relation(fields: [farmProductOfferId], references: [id])
  farmProductOfferId String?
  farmId             String?
  productDefinitionId String?
  actualWeightG      Int?
  // Extended snapshot facts preserved at reservation time.
  farmNameSnapshot   String?
  definitionNameSnapshot String?

  @@index([orderId])
  @@index([farmProductOfferId])
}

model Translation {
  id         String            @id @default(cuid())
  entityType String // "farm" | "product" | "pack" ...
  entityId   String
  field      String // e.g. "name", "description", "story"
  locale     String // "ca" | "es" | "en"
  text       String
  status     String @default("machine") // TranslationStatus enum, see header
  source     String @default("machine") // provenance

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityType, entityId, field, locale])
  @@index([entityType, entityId])
}

model AiRun {
  id            String   @id @default(cuid())
  useCase       String // "translate" | "metrics" | "receipt"
  provider      String // "mock" | "openai" ...
  model         String
  promptVersion String
  flagEnabled   Boolean
  inputRef      String   @default("")
  outputValid   Boolean  @default(false)
  outcome       String   @default("") // "ok" | "fallback" | "invalid" ...
  createdAt     DateTime @default(now())

  @@index([useCase])
}

// Audit trail for HUMAN admin actions (lifecycle transitions, approvals,
// rejections, receipt-driven creations). This is distinct from AiRun, which
// audits AI runs. Every human transition writes one row here so there is a
// durable, queryable record of who changed what (ai-guardrails: approvals and
// lifecycle changes are human-only and must be audited).
model AdminAudit {
  id         String   @id @default(cuid())
  actorId    String // User.id of the human who performed the action
  actorEmail String   @default("")
  actorRole  String   @default("")
  action     String // e.g. "lifecycle_transition" | "approve_translation" | "reject_translation" | "receipt_prefill_create"
  entityType String // "farm" | "product" | "translation" | "lot" ...
  entityId   String
  fromState  String   @default("")
  toState    String   @default("")
  detail     String   @default("")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

model MarketPriceSnapshot {
  id            String   @id @default(cuid())
  cutName       String
  weekStart     DateTime
  avgPriceCents Int
  sampleCount   Int
  generatedBy   String   @default("mock")
  createdAt     DateTime @default(now())

  @@unique([cutName, weekStart])
}
