# Vedella Local — environment example. Copy to .env and fill as needed.
# NEVER commit a real .env or any real API key. .env is git-ignored.

# Postgres database (Neon). The committed Prisma schema is Postgres, so BOTH
# local development and production now need a Postgres connection string.
#
# DATABASE_URL = the POOLED connection string. Used by the app at RUNTIME
# (serverless functions reuse pooled connections). Note the "-pooler" host.
# DIRECT_URL   = the DIRECT / non-pooled connection string. Used by Prisma for
# MIGRATIONS (prisma migrate deploy / dev). No "-pooler" in the host.
#
# These are SECRETS: put real values ONLY in your git-ignored .env locally and
# in the Vercel project environment variables. Keep placeholders here.
# For local dev you can create a free Neon dev branch and paste its two URLs.
# Full walkthrough: docs/deploy-vercel-neon.md
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob storage for farm-uploaded images. On Vercel the serverless
# filesystem is read-only/ephemeral, so uploads must go to Blob. Create a Blob
# store in the Vercel dashboard (Storage -> Create -> Blob) and Vercel adds this
# token automatically. When UNSET (local dev / offline / tests), the app writes
# to the local public/uploads directory instead. This is a SECRET; never commit
# a real value or log it. See docs/deploy-vercel-neon.md.
BLOB_READ_WRITE_TOKEN=

# AI provider selection: "mock" (default, zero-config offline) or a real provider.
AI_PROVIDER="mock"

# Real provider API key. Leave EMPTY to run fully offline with the MockAiProvider.
# A leaked key is considered compromised — never paste a real key anywhere but here.
AI_API_KEY=

# Per-use-case feature flags. When off (or no key), the app falls back to the mock
# provider / a no-op and never crashes.
AI_TRANSLATION_ENABLED="false"
AI_METRICS_ENABLED="false"
AI_RECEIPT_ENABLED="false"

# Bounded in-panel AI assistants (FEAT-007). Each only DRAFTS/SUGGESTS copy or
# insights for a human to accept/edit/reject with a reason; none can set prices,
# approve/publish, or create traceability. Off by default -> deterministic mock.
AI_FARM_PROFILE_DRAFT_ENABLED="false"
AI_OFFER_COMPARE_ENABLED="false"
AI_TRACEABILITY_REVIEW_ENABLED="false"
AI_METRICS_ANALYST_ENABLED="false"
AI_CYCLE_RECOMMENDATION_ENABLED="false"

# Temporary password used by the seed for the main admin (miguel@admin.com) and
# the other seeded demo identities. This is NOT a real secret — every seeded
# account starts with mustChangePassword=true and must set its own password on
# first login. Leave empty to use the documented non-secret development default.
SEED_ADMIN_TEMP_PASSWORD=
