# Vedella Local — environment example. Copy to .env and fill as needed.
# NEVER commit a real .env or any real API key. .env is git-ignored.

# Postgres database (Neon). The committed Prisma schema is Postgres, so BOTH
# local development and production now need a Postgres connection string.
#
# DATABASE_URL = the POOLED connection string. Used by the app at RUNTIME
# (serverless functions reuse pooled connections). Note the "-pooler" host.
# DIRECT_URL   = the DIRECT / non-pooled connection string. Used by Prisma for
# MIGRATIONS (prisma migrate deploy / dev). No "-pooler" in the host.
#
# These are SECRETS: put real values ONLY in your git-ignored .env locally and
# in the Vercel project environment variables. Keep placeholders here.
# For local dev you can create a free Neon dev branch and paste its two URLs.
# Full walkthrough: docs/deploy-vercel-neon.md
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- e2e / Playwright test database (FEAT-002) -------------------------------
# The Playwright e2e suite boots the dev server against a Vercel/Neon-realistic
# Postgres (provider=postgresql), NOT the offline SQLite path. Set ONE of the
# two paths below; when neither is set the e2e scripts fall back to the current
# local behaviour (prisma/seed.ts against whatever DATABASE_URL you have).
#
# These URLs are read by `npm run db:test:setup` and by Playwright's
# global-setup/webServer (TEST_DATABASE_URL takes precedence, then
# E2E_DATABASE_URL). NEVER put a real credential here — placeholders only.
#
# (a) LOCAL DOCKER path — `npm run db:test:setup` starts docker-compose.test.yml
#     (postgres:16 on port 5433) and this throwaway, NON-SECRET URL is used:
# TEST_DATABASE_URL="postgresql://vedella:vedella@localhost:5433/vedella_test"
#
# (b) NEON DEV-BRANCH path (Vercel-realistic) — create a Neon dev branch and
#     paste its DIRECT (non-pooled) connection string here via your git-ignored
#     .env or a CI secret. This mirrors the `vercel-build` flow (migrate deploy
#     -> seed -> next build) so the SAME e2e suite runs against a
#     Vercel-aligned Postgres. This is a SECRET; keep placeholders here only.
# E2E_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
#
# See docs/postgres-e2e-env.md for the full local-Docker vs Neon walkthrough.

# Vercel Blob storage for farm-uploaded images. On Vercel the serverless
# filesystem is read-only/ephemeral, so uploads must go to Blob. Create a Blob
# store in the Vercel dashboard (Storage -> Create -> Blob) and Vercel adds this
# token automatically. When UNSET (local dev / offline / tests), the app writes
# to the local public/uploads directory instead. This is a SECRET; never commit
# a real value or log it. See docs/deploy-vercel-neon.md.
BLOB_READ_WRITE_TOKEN=

# AI provider selection. Accepted values:
#   "mock"   -> default, deterministic, zero-config, runs fully offline.
#   "gemini" -> Google Gemini (free tier, model gemini-1.5-flash). Paste a free
#               key into GEMINI_API_KEY (or AI_API_KEY) below and set this to
#               "gemini". Get a key at https://aistudio.google.com/app/apikey
#   "openai" -> any OpenAI-compatible endpoint (uses AI_API_KEY + optional
#               AI_MODEL / AI_BASE_URL).
# With no key present the app ALWAYS stays on the mock, whatever this is set to.
AI_PROVIDER="mock"

# Google Gemini API key (free tier). Preferred key name when AI_PROVIDER="gemini".
# Leave EMPTY to run fully offline with the MockAiProvider.
# Optional: GEMINI_MODEL (defaults to gemini-1.5-flash).
# A leaked key is considered compromised — paste the real key ONLY here in your
# git-ignored .env (locally) or in the Vercel project env, NEVER in chat or code.
# The admin UI only ever shows whether a key is PRESENT, never its value.
GEMINI_API_KEY=

# Generic / OpenAI-compatible provider key. Also accepted as a FALLBACK key for
# Gemini when GEMINI_API_KEY is empty. Leave EMPTY to run fully offline.
# A leaked key is considered compromised — never paste a real key anywhere but here.
AI_API_KEY=

# Per-use-case feature flags. When off (or no key), the app falls back to the mock
# provider / a no-op and never crashes.
AI_TRANSLATION_ENABLED="false"
AI_METRICS_ENABLED="false"
AI_RECEIPT_ENABLED="false"

# Bounded in-panel AI assistants (FEAT-007). Each only DRAFTS/SUGGESTS copy or
# insights for a human to accept/edit/reject with a reason; none can set prices,
# approve/publish, or create traceability. Off by default -> deterministic mock.
AI_FARM_PROFILE_DRAFT_ENABLED="false"
AI_OFFER_COMPARE_ENABLED="false"
AI_TRACEABILITY_REVIEW_ENABLED="false"
AI_METRICS_ANALYST_ENABLED="false"
AI_CYCLE_RECOMMENDATION_ENABLED="false"

# A/B-testing copy loop (FEAT-004): the AI PROPOSER drafts alternative product
# descriptions and the LLM-as-JUDGE scores them PASS/FAIL/UNKNOWN. Both only
# draft/score — a human always decides, approves and publishes; the AI never
# prices, approves, publishes, or flips status. Off by default -> deterministic
# mock. This flag gates ONLY whether the REAL provider is used for the loop.
AI_COPY_AB_TESTING_ENABLED="false"

# Temporary password used by the seed for the main admin (miguel@admin.com) and
# the other seeded demo identities. This is NOT a real secret — every seeded
# account starts with mustChangePassword=true and must set its own password on
# first login. Leave empty to use the documented non-secret development default.
SEED_ADMIN_TEMP_PASSWORD=
