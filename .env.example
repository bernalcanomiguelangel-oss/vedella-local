# Vedella Local — environment example. Copy to .env and fill as needed.
# NEVER commit a real .env or any real API key. .env is git-ignored.

# Local SQLite database file (Prisma).
DATABASE_URL="file:./dev.db"

# AI provider selection: "mock" (default, zero-config offline) or a real provider.
AI_PROVIDER="mock"

# Real provider API key. Leave EMPTY to run fully offline with the MockAiProvider.
# A leaked key is considered compromised — never paste a real key anywhere but here.
AI_API_KEY=

# Per-use-case feature flags. When off (or no key), the app falls back to the mock
# provider / a no-op and never crashes.
AI_TRANSLATION_ENABLED="false"
AI_METRICS_ENABLED="false"
AI_RECEIPT_ENABLED="false"

# Bounded in-panel AI assistants (FEAT-007). Each only DRAFTS/SUGGESTS copy or
# insights for a human to accept/edit/reject with a reason; none can set prices,
# approve/publish, or create traceability. Off by default -> deterministic mock.
AI_FARM_PROFILE_DRAFT_ENABLED="false"
AI_OFFER_COMPARE_ENABLED="false"
AI_TRACEABILITY_REVIEW_ENABLED="false"
AI_METRICS_ANALYST_ENABLED="false"
AI_CYCLE_RECOMMENDATION_ENABLED="false"

# Temporary password used by the seed for the main admin (miguel@admin.com) and
# the other seeded demo identities. This is NOT a real secret — every seeded
# account starts with mustChangePassword=true and must set its own password on
# first login. Leave empty to use the documented non-secret development default.
SEED_ADMIN_TEMP_PASSWORD=
